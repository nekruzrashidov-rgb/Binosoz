{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*",
  "Redis": {
    "ConnectionString": "",
    "InstanceName": "binosoz:"
  },
  "Jwt": {
    "Issuer": "sitora-api",
    "Audience": "sitora-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  }
}
