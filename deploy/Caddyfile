# Caddy получает и продлевает сертификат Let's Encrypt для API_DOMAIN сам,
# перенаправляет HTTP на HTTPS и проксирует запросы (включая WebSocket для /hubs) в API.
{$API_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 25MB
	}

	reverse_proxy webapi:8080

	# В журнале доступа нет токенов: SignalR передаёт access-токен в строке запроса (?access_token=…),
	# остальные запросы — в заголовке Authorization. Оба маскируются, остальное пишется в JSON как раньше.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					replace access_token REDACTED
				}
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
}
