# Скопируйте в .env и задайте свои значения. Файл .env в git не попадает.
POSTGRES_PASSWORD=
# Не короче 32 символов, например вывод: openssl rand -base64 48
JWT_KEY=
# Ключ шифрования паспортных данных: ровно 32 байта в base64, например: openssl rand -base64 32
# Если потерять ключ, зашифрованные паспортные данные не восстановить. Храните копию отдельно от бэкапов базы.
ENCRYPTION_KEY=

# ---- Разработка (docker-compose.yml) ----
ASPNETCORE_ENVIRONMENT=Development
# Пароли пользователей сидера (только Development): от 8 символов, с цифрой, строчной и заглавной буквой.
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_ACCOUNTANT_PASSWORD=
SEED_CONTENT_PASSWORD=
# Владелец второго демо-застройщика Rich Tower (owner@rich-tower.tj); без пароля он входит по коду из почты.
SEED_RICHTOWER_OWNER_PASSWORD=

# ---- Продакшен (docker-compose.prod.yml) ----
# Домен API, на который смотрит A-запись сервера, например api.sitora.tj
API_DOMAIN=
# Адреса фронтендов для CORS, например https://sitora.tj и https://crm.sitora.tj
SITE_ORIGIN=
CRM_ORIGIN=
# Первый владелец организации по умолчанию: создаётся при первом запуске, если владельцев ещё нет. Потом строки можно удалить.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Создатель платформы (скрытая роль PlatformOwner): входит по коду из почты и вторым фактором — этим паролем.
# Создаётся командой --migrate (в Development — при старте API). Пароль: лучше от 12 символов, с цифрой, строчной и заглавной буквой.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Почта: коды входа и приглашения. EMAIL_PROVIDER = Smtp, Resend или Gmail (Dev пишет коды только в лог разработки).
EMAIL_PROVIDER=
# Адрес отправителя; для Resend — на подтверждённом домене.
EMAIL_FROM=
# Страница принятия приглашения во фронтенде; токен дописывается в конец.
EMAIL_INVITE_URL=
# Для Smtp:
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Для Resend (https://resend.com → API Keys):
RESEND_API_KEY=
# Для Gmail API (HTTPS; работает там, где исходящий SMTP закрыт): OAuth-клиент Desktop app и refresh token
# из scripts/gmail-token.mjs (docs/DEPLOY.md, «Почта через Gmail API»).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# AI-помощник в чате сайта (https://console.anthropic.com → API Keys). Без ключа помощник отвечает «не настроен».
CLAUDE_API_KEY=

# Хранилище файлов (договоры, сканы, фото стройки). Local — папка /app/storage на томе files (VPS, docker compose).
# На Render диск временный: нужен S3 (Cloudflare R2, Backblaze B2, MinIO, AWS) или Render Disk со Storage__RootPath.
# В панели Render переменные пишутся как Storage__Provider, Storage__S3__Endpoint и т. д.
STORAGE_PROVIDER=Local
# Адрес S3-совместимого сервиса: dev — http://s3:9000 (RustFS из docker compose); R2 — https://<account>.r2.cloudflarestorage.com. Пусто — AWS S3.
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
# Ключи доступа к бакету; для RustFS из docker compose — его ключи (секрет от 8 символов).
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_REGION=us-east-1

# Ошибки в Sentry или GlitchTip (Error и выше, без персональных данных). Пусто — никуда не отправляются.
# В панели Render — Sentry__Dsn.
SENTRY_DSN=
# Ключ для /health/ready и /health снаружи (заголовок X-Health-Key). Пусто — подробная проверка только из внутренней сети.
# /health/live открыт всегда. В панели Render — Health__Key.
HEALTH_KEY=
# Refresh-токен: Dual — в cookie sitora_rt и в теле ответа (по умолчанию), Cookie — только cookie, Body — только тело.
# В панели Render — Auth__RefreshCookie__Mode.
AUTH_REFRESH_COOKIE_MODE=Dual
