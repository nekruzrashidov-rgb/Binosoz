# Скопируйте в .env и задайте свои значения. Файл .env в git не попадает.
POSTGRES_PASSWORD=
# Не короче 32 символов, например вывод: openssl rand -base64 48
JWT_KEY=
# Ключ шифрования паспортных данных: ровно 32 байта в base64, например: openssl rand -base64 32
# Если потерять ключ, зашифрованные паспортные данные не восстановить. Храните копию отдельно от бэкапов базы.
ENCRYPTION_KEY=

# ---- Разработка (docker-compose.yml) ----
ASPNETCORE_ENVIRONMENT=Development
# Пароли пользователей сидера (только Development): от 8 символов, с цифрой, строчной и заглавной буквой.
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_ACCOUNTANT_PASSWORD=
SEED_CONTENT_PASSWORD=
# Владелец второго демо-застройщика (owner@second-builder.tj, только Development); без пароля он входит по коду из почты.
SEED_RICHTOWER_OWNER_PASSWORD=

# ---- Продакшен (docker-compose.prod.yml) ----
# Домен API, на который смотрит A-запись сервера, например api.sitora.tj
API_DOMAIN=
# Адреса фронтендов для CORS, например https://sitora.tj и https://crm.sitora.tj
SITE_ORIGIN=
CRM_ORIGIN=
# Первый владелец организации по умолчанию: создаётся при первом запуске, если владельцев ещё нет. Потом строки можно удалить.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Создатель платформы (скрытая роль PlatformOwner): входит по коду из почты и вторым фактором — этим паролем.
# Создаётся командой --migrate (в Development — при старте API). Пароль: лучше от 12 символов, с цифрой, строчной и заглавной буквой.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Почта: коды входа и приглашения. EMAIL_PROVIDER = Smtp, Resend или Gmail (Dev пишет коды только в лог разработки).
EMAIL_PROVIDER=
# Адрес отправителя; для Resend — на подтверждённом домене.
EMAIL_FROM=
# Страница принятия приглашения во фронтенде; токен дописывается в конец.
EMAIL_INVITE_URL=
# Для Smtp:
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Для Resend (https://resend.com → API Keys):
RESEND_API_KEY=
# Для Gmail API (HTTPS; работает там, где исходящий SMTP закрыт): OAuth-клиент Desktop app и refresh token
# из backend/scripts/gmail-token.mjs (docs/DEPLOY.md, «Почта через Gmail API»).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# AI-помощник в чате сайта (https://console.anthropic.com → API Keys). Без ключа помощник отвечает «не настроен».
CLAUDE_API_KEY=
# Вопросов гостей к помощнику на публичном сайте в сутки на организацию (на IP — 6 в минуту и 40 в сутки).
CLAUDE_PUBLIC_DAILY_LIMIT=300

# Хранилище файлов (договоры, сканы, фото стройки). Local — папка /app/storage на томе files (VPS, docker compose).
# На Render диск временный: нужен S3 (Cloudflare R2, Backblaze B2, MinIO, AWS) или Render Disk со Storage__RootPath.
# В панели Render переменные пишутся как Storage__Provider, Storage__S3__Endpoint и т. д.
STORAGE_PROVIDER=Local
# Адрес S3-совместимого сервиса: dev — http://s3:9000 (RustFS из docker compose); R2 — https://<account>.r2.cloudflarestorage.com. Пусто — AWS S3.
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
# Ключи доступа к бакету; для RustFS из docker compose — его ключи (секрет от 8 символов).
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_REGION=us-east-1
# Для R2 (https) подпись тела и контрольные суммы настраиваются сами. Переопределить в Render: Storage__S3__UnsignedPayload,
# Storage__S3__ChecksumWhenRequired, Storage__S3__ConditionalWrites (docs/DEPLOY.md, «Файлы на Render»).

# Ошибки в Sentry или GlitchTip (Error и выше, без персональных данных). Пусто — никуда не отправляются.
# В панели Render — Sentry__Dsn.
SENTRY_DSN=
# Ключ для /health/ready и /health (заголовок X-Health-Key). Без ключа — только общий статус { status };
# в Production внутренний адрес подробностей не даёт (на Render все запросы идут через прокси).
# /health/live открыт всегда. В панели Render — Health__Key.
HEALTH_KEY=
# Refresh-токен: Dual — в cookie sitora_rt и в теле ответа (по умолчанию), Cookie — только cookie, Body — только тело.
# В панели Render — Auth__RefreshCookie__Mode.
AUTH_REFRESH_COOKIE_MODE=Dual
# Тестовый банк (payment.html, POST /payment/mock/simulate) вне Development: true — только на время показа жюри.
# Деньги не списываются; на странице банка — плашка «Тестовый банк». В панели Render — Payments__MockEnabled.
PAYMENTS_MOCK_ENABLED=false
# Вход демо-покупателя (demo-buyer@binosoz.tj) паролем для жюри — только на время показа. В панели Render — Auth__DemoPasswordLogin.
DEMO_PASSWORD_LOGIN=false
# Броней с сайта (гость или покупатель) не больше стольких активных на один IP; 0 — без лимита. В Render — Booking__GuestActivePerIp.
BOOKING_GUEST_ACTIVE_PER_IP=3
# Заголовок с адресом клиента от доверенного прокси (например, CF-Connecting-IP за Cloudflare). Пусто — последний адрес
# X-Forwarded-For. Включать только после проверки по логам (docs/DECISIONS.md, A-15). В Render — ForwardedHeaders__ClientIpHeader.
FORWARDED_CLIENT_IP_HEADER=

# Telegram (docs/DEPLOY.md, «Как подключить бота Telegram и Telegram Gateway»). Пусто — канал выключен.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Имя бота без @ и секрет webhook (32+ символов [A-Za-z0-9_-]).
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Telegram Gateway — коды входа по телефону (платно) и суточный лимит отправок.
TELEGRAM_GATEWAY_TOKEN=
TELEGRAM_GATEWAY_DAILY_LIMIT=200
# Адрес API для ссылки «Отписаться» в письмах, если сайт на другом домене.
EMAIL_API_URL=

# Карта Google на сайте (Maps Embed API): ключ публичный по природе — ограничьте его в Google Cloud (docs/DEPLOY.md,
# «Карта Google»). Пусто — на сайте только ссылки «Открыть в Google Картах» и «Маршрут».
Maps__EmbedKey=
