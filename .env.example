# Скопируйте в .env и задайте свои значения. Файл .env в git не попадает.
POSTGRES_PASSWORD=
# Не короче 32 символов, например вывод: openssl rand -base64 48
JWT_KEY=
# Ключ шифрования паспортных данных: ровно 32 байта в base64, например: openssl rand -base64 32
# Если потерять ключ, зашифрованные паспортные данные не восстановить. Храните копию отдельно от бэкапов базы.
ENCRYPTION_KEY=

# ---- Разработка (docker-compose.yml) ----
ASPNETCORE_ENVIRONMENT=Development
# Пароли пользователей сидера (только Development): от 8 символов, с цифрой, строчной и заглавной буквой.
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_ACCOUNTANT_PASSWORD=
SEED_CONTENT_PASSWORD=

# ---- Продакшен (docker-compose.prod.yml) ----
# Домен API, на который смотрит A-запись сервера, например api.sitora.tj
API_DOMAIN=
# Адреса фронтендов для CORS, например https://sitora.tj и https://crm.sitora.tj
SITE_ORIGIN=
CRM_ORIGIN=
# Первый администратор: создаётся при первом запуске, если админов ещё нет. Потом строки можно удалить.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
