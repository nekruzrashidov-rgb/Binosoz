{
  "buildCommand": "sh build-version.sh",
  "outputDirectory": ".",
  "installCommand": null,
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/apartments",
      "destination": "/apartments.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/register",
      "destination": "/register.html"
    },
    {
      "source": "/accept-invite",
      "destination": "/accept-invite.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/cabinet",
      "destination": "/cabinet.html"
    },
    {
      "source": "/crm",
      "destination": "/crm.html"
    },
    {
      "source": "/platform",
      "destination": "/platform.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://binosoz-1.onrender.com wss://binosoz-1.onrender.com https://fonts.googleapis.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-src https://www.google.com; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
